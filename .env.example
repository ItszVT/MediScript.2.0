# Copy to .env for local development (all optional — sensible defaults apply).

# Security — CHANGE THIS in production (Render generates one automatically).
SECRET_KEY=dev-secret-change-me

# Database. Default is a local SQLite file. For Postgres:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./mediscript.db

# OCR.space Engine 3 — the ONLY OCR engine. Comma-separate multiple keys to
# rotate quota. "helloworld" is OCR.space's shared demo key (rate-limited).
OCRSPACE_KEYS=helloworld

# Optional: point at a different medicine dataset CSV (name column required).
# MEDICINE_CSV=data/medicines_master.csv

# Optional medical NER model (leave blank to use the built-in heuristic detector)
# DRUG_NER_MODEL=en_core_med7_lg
# DRUG_NER_LABELS=DRUG
